# Anthropic API 配置（MODEL_PROVIDER=anthropic, 默认）
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible 配置（MODEL_PROVIDER=openai-compatible）
# 适用于：OpenAI / DeepSeek / 通义千问 / Ollama / OpenRouter / vLLM ……
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-xxx

# 选哪个 provider（anthropic | openai-compatible）
MODEL_PROVIDER=anthropic

# 模型 id —— 根据实际 provider 填写对应模型名称
MODEL_GENERATOR=claude-sonnet-4-6
MODEL_GRADER=claude-haiku-4-5-20251001
MODEL_COACH=claude-haiku-4-5-20251001

# 前端允许选择的模型列表（逗号分隔；缺省回退到 MODEL_GENERATOR + MODEL_GRADER）
MODELS_ALLOWED=deepseek-v4-pro,deepseek-v4-flash

# 服务端口
PORT=5174

# 会话结束时自动 git commit（设为 1 启用）
AUTO_COMMIT=0