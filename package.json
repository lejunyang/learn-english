{
  "name": "learn-english",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:server && pnpm build:web",
    "start": "node dist/server/index.js",
    "kill": "node scripts/kill-ports.mjs",
    "ingest:ecdict": "tsx scripts/ingest-ecdict.ts",
    "ingest:scenario": "tsx scripts/ingest-scenario.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@hono/node-server": "^2.0.4",
    "@mastra/core": "^1.41.0",
    "dotenv": "^17.0.0",
    "hono": "^4.12.0",
    "jotai": "^2.20.0",
    "ts-fsrs": "^4.5.0",
    "ulid": "^2.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "csv-parse": "^6.2.1",
    "postcss": "^8.4.49",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
